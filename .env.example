# 非敏感配置样例
# 复制为 .env 后按需修改；真实密钥只放本地环境变量，不提交 Git。

# --- 运行 ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# --- 令牌（生产必填，开发留空则用 dev-only-*）---
# STAGE_TOKEN=
# INGEST_TOKEN=
# STUDIO_TOKEN=

# 开发模式允许无凭证的模拟注入；生产强制 false
DEV_ALLOW_MOCK_INGEST=true

# --- 数据 ---
DATA_DIR=runtime
STORAGE_ROOT=runtime/storage
ROOM_ID=room-main

# --- TTS ---
# mock：本地生成可播放 WAV（默认，明确标记 mock 语音）
# none：纯字幕模式（不合成、不假装有音频）
SPEECH_ADAPTER=mock
# SPEECH_VOICE=mock-sine

# --- 模型 ---
# mock：确定性替身（当前默认）
# hs-gw：真实网关（协议未核实，缺凭证会显式降级）
MODEL_ADAPTER=mock
# HS_GW_BASE_URL=
# HS_GW_API_KEY=
# HS_GW_MODEL=

# --- 工具数据源 ---
LOL_ADAPTER=mock
# LOL_HTTP_BASE_URL=
# LOL_HTTP_TOKEN=

# --- 预算（初始调参值，不是性能承诺）---
BUDGET_MAX_MODEL_CALLS=3
BUDGET_MAX_TOOL_CALLS=3
BUDGET_MODEL_TIMEOUT_MS=15000
BUDGET_TOOL_TIMEOUT_MS=8000
BUDGET_TURN_DEADLINE_MS=30000

# --- 多房间 ---
# 同时存在的房间上限（防外部 roomId 撑爆内存）
MAX_ROOMS=20

# --- 数据保留（天；0 表示不自动清理）---
RETENTION_EVENTS_DAYS=7
RETENTION_MESSAGES_DAYS=7
RETENTION_TURNS_DAYS=30
RETENTION_SOUVENIRS_DAYS=30
RETENTION_MEMORIES_GRACE_DAYS=0
# 清理间隔（分钟）；0 关闭定时清理
RETENTION_INTERVAL_MINUTES=60

# --- 队列与上下文 ---
QUEUE_MAX_PENDING=32
RATE_LIMIT_PER_MINUTE=30
CONTEXT_MAX_MESSAGES=12
